<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Scramble.Presentation.ViewModels"
             xmlns:converters="using:Scramble.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="Scramble.UI.Views.ChatListView"
             x:DataType="vm:ChatListViewModel">
    <UserControl.Resources>
        <converters:FilePathToBitmapConverter x:Key="FilePathToBitmap" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <!-- Tab Bar: Chats / Agents (DVM) / Archived -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="12,8,12,0">
                <!-- Chats tab (active when neither agents nor archived) -->
                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,6" Background="Transparent" BorderThickness="0"
                        IsVisible="{Binding ShowArchivedSection}"
                        Command="{Binding ToggleArchivedViewCommand}">
                    <TextBlock Text="Chats" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,6" Background="Transparent" BorderThickness="0"
                        IsVisible="{Binding ShowAgentsSection}"
                        Command="{Binding ToggleAgentsViewCommand}">
                    <TextBlock Text="Chats" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
                <Border Grid.Column="0" Padding="0,6"
                        IsVisible="{Binding !ShowArchivedSection}"
                        IsEnabled="{Binding !ShowAgentsSection}"
                        BorderBrush="{DynamicResource NostrPurpleLightBrush}"
                        BorderThickness="0,0,0,2">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!ShowArchivedSection" />
                            <Binding Path="!ShowAgentsSection" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <TextBlock Text="Chats" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource NostrPurpleLightBrush}" />
                </Border>

                <!-- Agents (DVM) tab -->
                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,6" Background="Transparent" BorderThickness="0"
                        Command="{Binding ToggleAgentsViewCommand}"
                        IsVisible="{Binding !ShowAgentsSection}">
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Agents (DVM) ({0})">
                                <Binding Path="AgentChatsCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Border Grid.Column="1" Padding="0,6"
                        IsVisible="{Binding ShowAgentsSection}"
                        BorderBrush="{DynamicResource NostrPurpleLightBrush}"
                        BorderThickness="0,0,0,2">
                    <TextBlock FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource NostrPurpleLightBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Agents (DVM) ({0})">
                                <Binding Path="AgentChatsCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>

                <!-- Archived tab -->
                <Button Grid.Column="2"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,6" Background="Transparent" BorderThickness="0"
                        Command="{Binding ToggleArchivedViewCommand}"
                        IsVisible="{Binding !ShowArchivedSection}">
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Archived ({0})">
                                <Binding Path="ArchivedChatsCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Border Grid.Column="2" Padding="0,6"
                        IsVisible="{Binding ShowArchivedSection}"
                        BorderBrush="{DynamicResource NostrPurpleLightBrush}"
                        BorderThickness="0,0,0,2">
                    <TextBlock FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource NostrPurpleLightBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Archived ({0})">
                                <Binding Path="ArchivedChatsCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Search Box -->
        <Border Grid.Row="1" Padding="12">
            <TextBox Text="{Binding SearchText}"
                     PlaceholderText="Search chats..."
                     Classes="search">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}"
                              Margin="8,0,0,0" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Border>

        <!-- Pending Invites Section -->
        <Border Grid.Row="2" Padding="12,0,12,8"
                IsVisible="{Binding PendingInvites.Count}">
            <StackPanel Spacing="8">

                <!-- Invite Items -->
                <ItemsControl ItemsSource="{Binding PendingInvites}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingInviteItemViewModel">
                            <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,4">
                                <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Sender Avatar -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource NostrPurpleBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SenderInitial}"
                                                   FontSize="16" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Invite Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding SenderName, StringFormat='Group invite from {0}'}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding TimeAgo}"
                                                       Classes="muted" FontSize="11" />
                                            <TextBlock Text="{Binding GroupId, StringFormat='Group: {0}'}"
                                                       Classes="muted" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120"
                                                       IsVisible="{Binding GroupId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Accept/Decline Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Classes="primary" Padding="8,4"
                                                Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).AcceptInviteCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding !IsProcessing}"
                                                ToolTip.Tip="Accept invite">
                                            <Panel>
                                                <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                          Width="14" Height="14"
                                                          IsVisible="{Binding !IsAccepting}" />
                                                <TextBlock Text="Accepting..."
                                                           FontSize="11" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsAccepting}" />
                                            </Panel>
                                        </Button>
                                        <Button Classes="secondary" Padding="8,4"
                                                Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).DeclineInviteCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding !IsProcessing}"
                                                ToolTip.Tip="Decline invite">
                                            <Panel>
                                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                          Width="14" Height="14"
                                                          IsVisible="{Binding !IsDeclining}" />
                                                <TextBlock Text="Declining..."
                                                           FontSize="11" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsDeclining}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Processing indicator below the invite -->
                                <TextBlock Text="Processing invite..."
                                           Classes="muted" FontSize="11"
                                           Margin="50,4,0,0"
                                           IsVisible="{Binding IsProcessing}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Skipped invites notice (no key material on this device) -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                Padding="12,8"
                IsVisible="{Binding SkippedInviteCount}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Classes="secondary" FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} group invite(s) received — encryption keys not available on this device">
                            <Binding Path="SkippedInviteCount" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <!-- Retry, because Dismiss was the only way out of a notice about
                     invites the app had ALREADY dismissed for you. A skipped invite is
                     unreachable afterwards: the dismissal is checked by both the live
                     handler and the rescan, and the only other escape needs a chat that
                     a pending invite does not have. Asking the sender to invite you
                     again was the entire workaround. -->
                <Button Grid.Column="1"
                        Classes="secondary"
                        Content="Retry"
                        FontSize="11"
                        Padding="8,4"
                        Margin="8,0,0,0"
                        Command="{Binding RetryDismissedInvitesCommand}" />
                <Button Grid.Column="2"
                        Classes="secondary"
                        Content="Dismiss"
                        FontSize="11"
                        Padding="8,4"
                        Margin="8,0,0,0"
                        Command="{Binding DismissSkippedInviteNoticeCommand}" />
            </Grid>
        </Border>

        <!-- Chat List (active chats only) -->
        <ListBox Grid.Row="4"
                 x:Name="ChatListBox"
                 ItemsSource="{Binding Chats}"
                 SelectedItem="{Binding SelectedChat}"
                 Background="Transparent">
            <ListBox.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!ShowArchivedSection" />
                    <Binding Path="!ShowAgentsSection" />
                </MultiBinding>
            </ListBox.IsVisible>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsVisible}">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Archive"
                                          Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).ArchiveChatCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z"
                                                  Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Rename"
                                          Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).RenameChatCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                  Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).ToggleMuteCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Header>
                                        <Panel>
                                            <TextBlock Text="Mute" IsVisible="{Binding !IsMuted}" />
                                            <TextBlock Text="Unmute" IsVisible="{Binding IsMuted}" />
                                        </Panel>
                                    </MenuItem.Header>
                                    <MenuItem.Icon>
                                        <PathIcon Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                                                  Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Reset Group"
                                          IsVisible="{Binding IsGroup}"
                                          Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).ResetGroupCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                  Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete"
                                          Command="{Binding #ChatListBox.((vm:ChatListViewModel)DataContext).DeleteChatCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                  Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                Background="Transparent"
                                BorderBrush="{DynamicResource NostrPurpleBrush}" BorderThickness="2"
                                Margin="0,0,12,0">
                            <Panel>
                                <!-- Cached avatar image -->
                                <Ellipse Width="44" Height="44"
                                         IsVisible="{Binding LocalAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Ellipse.Fill>
                                        <ImageBrush Source="{Binding LocalAvatarPath, Converter={StaticResource FilePathToBitmap}}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Name initial fallback (non-bot, no cached image) -->
                                <TextBlock Text="{Binding Name[0]}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NostrPurpleBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsBot" />
                                            <Binding Path="LocalAvatarPath" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>

                                <!-- Bot / Linked device: plug/connector icon -->
                                <PathIcon Data="M16,7V3H14V7H10V3H8V7C7,7 6,8 6,9V14.5L9.5,18V21H14.5V18L18,14.5V9C18,8 17,7 16,7Z"
                                          Width="22" Height="22"
                                          Foreground="{DynamicResource NostrPurpleBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsBot" />
                                            <Binding Path="LocalAvatarPath" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </PathIcon.IsVisible>
                                </PathIcon>

                                <!-- Group Icon Indicator -->
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{DynamicResource BackgroundLightBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        IsVisible="{Binding IsGroup}">
                                    <PathIcon Data="M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91zM4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58A2.01 2.01 0 0 0 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29zM20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm4 3.43c0-.81-.48-1.53-1.22-1.85A6.95 6.95 0 0 0 20 14c-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24v-1.57zM12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3z"
                                              Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Panel>
                        </Border>

                        <!-- Chat Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="{Binding LastActivityAt, StringFormat={}{0:HH:mm}}"
                                               Classes="muted" FontSize="12"
                                               HorizontalAlignment="Right" />
                                    <!-- Muted / Pinned icons below timestamp -->
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Right">
                                        <PathIcon Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                                                  Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                                                  IsVisible="{Binding IsMuted}" />
                                        <PathIcon Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"
                                                  Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                                                  IsVisible="{Binding IsPinned}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding LastMessagePreview}"
                                           Classes="secondary" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />

                                <!-- Unread Badge -->
                                <Border Grid.Column="1"
                                        IsVisible="{Binding HasUnread}"
                                        Background="{DynamicResource NostrPurpleBrush}"
                                        CornerRadius="10" MinWidth="20" Height="20"
                                        Padding="6,0" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding UnreadCount}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Loading Indicator -->
        <Border Grid.Row="4" Background="{DynamicResource BackgroundMediumBrush}"
                IsVisible="{Binding IsLoading}" Opacity="0.9">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <!-- Spinning circle indicator -->
                <Border Width="40" Height="40" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20"
                            BorderThickness="3" BorderBrush="{DynamicResource SurfaceSecondaryBrush}">
                        <Border.RenderTransform>
                            <RotateTransform />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                             Foreground="{DynamicResource NostrPurpleBrush}" />
                <TextBlock Text="Loading conversations..." Classes="secondary" FontSize="13"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

            <!-- Empty State (hidden while loading, only on main Chats tab) -->
            <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!Chats.Count" />
                        <Binding Path="!IsLoading" />
                        <Binding Path="!ShowAgentsSection" />
                        <Binding Path="!ShowArchivedSection" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <PathIcon Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"
                          Width="48" Height="48" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="No chats yet" Classes="secondary" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Agents Empty State -->
            <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!AgentChats.Count" />
                        <Binding Path="!IsLoading" />
                        <Binding Path="ShowAgentsSection" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <PathIcon Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"
                          Width="48" Height="48" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="No agent chats yet" Classes="secondary" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Archived Empty State -->
            <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!ArchivedChats.Count" />
                        <Binding Path="!IsLoading" />
                        <Binding Path="ShowArchivedSection" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <PathIcon Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"
                          Width="48" Height="48" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="No archived chats" Classes="secondary" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Agents (DVM) Chat List -->
            <ListBox Grid.Row="4"
                     x:Name="AgentListBox"
                     ItemsSource="{Binding AgentChats}"
                     SelectedItem="{Binding SelectedChat}"
                     IsVisible="{Binding ShowAgentsSection}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsVisible}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Archive"
                                              Command="{Binding #AgentListBox.((vm:ChatListViewModel)DataContext).ArchiveChatCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Rename"
                                              Command="{Binding #AgentListBox.((vm:ChatListViewModel)DataContext).RenameChatCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Command="{Binding #AgentListBox.((vm:ChatListViewModel)DataContext).ToggleMuteCommand}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Header>
                                            <Panel>
                                                <TextBlock Text="Mute" IsVisible="{Binding !IsMuted}" />
                                                <TextBlock Text="Unmute" IsVisible="{Binding IsMuted}" />
                                            </Panel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Delete"
                                              Command="{Binding #AgentListBox.((vm:ChatListViewModel)DataContext).DeleteChatCommand}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="Transparent"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <Panel>
                                    <PathIcon Width="24" Height="24" IsVisible="{Binding LocalAvatarPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                    <Border CornerRadius="24" ClipToBounds="True"
                                            IsVisible="{Binding LocalAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Image Width="48" Height="48"
                                               Source="{Binding LocalAvatarPath}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding LastMessagePreview}" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Archived Chat List (same layout as main, different context menu) -->
            <ListBox Grid.Row="4"
                     ItemsSource="{Binding ArchivedChats}"
                     SelectedItem="{Binding SelectedChat}"
                     IsVisible="{Binding ShowArchivedSection}"
                     Background="Transparent"
                     x:Name="ArchivedListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsVisible}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Unarchive"
                                              Command="{Binding #ArchivedListBox.((vm:ChatListViewModel)DataContext).UnarchiveChatCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Delete"
                                              Command="{Binding #ArchivedListBox.((vm:ChatListViewModel)DataContext).DeleteChatCommand}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource NostrPurpleBrush}" BorderThickness="2"
                                    Margin="0,0,12,0">
                                <Panel>
                                    <Ellipse Width="44" Height="44"
                                             IsVisible="{Binding LocalAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Ellipse.Fill>
                                            <ImageBrush Source="{Binding LocalAvatarPath, Converter={StaticResource FilePathToBitmap}}"
                                                        Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name[0]}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource NostrPurpleBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding LocalAvatarPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </Panel>
                            </Border>
                            <!-- Name + last message -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastMessagePreview}"
                                           Classes="muted" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- Unread badge -->
                            <Border Grid.Column="2"
                                    IsVisible="{Binding HasUnread}"
                                    Background="{DynamicResource NostrPurpleBrush}"
                                    CornerRadius="10" MinWidth="20" Height="20"
                                    Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnreadCount}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status Bar -->
            <Border Grid.Row="5"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Padding="12,8"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#x23F3;" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="secondary" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Delete Chat Confirmation Dialog -->
        <Border IsVisible="{Binding ShowDeleteChatDialog}"
                Background="#80000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="card"
                    Background="{DynamicResource BackgroundCardBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="16"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    MaxWidth="350">
                <StackPanel Spacing="16">
                    <!-- Dialog Title -->
                    <TextBlock Text="Delete Conversation"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" />

                    <!-- Confirmation Message -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Are you sure you want to delete this conversation?"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ChatToDelete.Name}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="This will delete all messages in this chat. This action cannot be undone."
                                   Classes="secondary" FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="Cancel"
                                Command="{Binding CancelDeleteChatCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Background="{DynamicResource StatusErrorBrush}"
                                Content="Delete"
                                Command="{Binding ConfirmDeleteChatCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reset Group Confirmation Dialog -->
        <Border IsVisible="{Binding ShowResetGroupDialog}"
                Background="#80000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="card"
                    Background="{DynamicResource BackgroundCardBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="16"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    MaxWidth="350">
                <StackPanel Spacing="16">
                    <!-- Dialog Title -->
                    <TextBlock Text="Reset Group"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" />

                    <!-- Confirmation Message -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Reset encryption state for this group?"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding GroupToReset.Name}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="This will clear encryption state and remove this chat. You'll need to re-accept the group invite."
                                   Classes="secondary" FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="Cancel"
                                Command="{Binding CancelResetGroupCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Background="{DynamicResource ResetButtonBrush}"
                                Content="Reset"
                                Command="{Binding ConfirmResetGroupCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Rename Chat Dialog -->
        <Border IsVisible="{Binding ShowRenameChatDialog}"
                Background="#80000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="card"
                    Background="{DynamicResource BackgroundCardBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="16"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    MaxWidth="350">
                <StackPanel Spacing="16">
                    <TextBlock Text="Rename Chat"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBox Text="{Binding RenameChatInput}"
                             PlaceholderText="Chat name" />
                    <Grid ColumnDefinitions="*,12,*">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="Cancel"
                                Command="{Binding CancelRenameChatCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="primary"
                                Content="Save"
                                Command="{Binding ConfirmRenameChatCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
