<?xml version="1.0" encoding="utf-8"?>
<!--
  One horizontal row, shown on long-pressing a message.

  This replaces a vertical PopupMenu that listed Reply, Copy text and then six
  emoji as separate rows: the emoji fell below the fold and had to be scrolled
  to, so the feature read as missing. A row fits every option on screen at once.

  Reply stays here as well as on the swipe gesture. The swipe is the fast path
  but it is invisible, and a gesture cannot be the only way to reach an action.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/reaction_0"
            style="@style/ReactionBarItem"
            android:text="👍" />

        <TextView
            android:id="@+id/reaction_1"
            style="@style/ReactionBarItem"
            android:text="❤️" />

        <TextView
            android:id="@+id/reaction_2"
            style="@style/ReactionBarItem"
            android:text="😂" />

        <TextView
            android:id="@+id/reaction_3"
            style="@style/ReactionBarItem"
            android:text="😮" />

        <TextView
            android:id="@+id/reaction_4"
            style="@style/ReactionBarItem"
            android:text="😢" />

        <TextView
            android:id="@+id/reaction_5"
            style="@style/ReactionBarItem"
            android:text="🔥" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="4dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:id="@+id/reaction_reply"
            style="@style/ReactionBarItem"
            android:text="↩"
            android:contentDescription="Reply" />

        <TextView
            android:id="@+id/reaction_copy"
            style="@style/ReactionBarItem"
            android:text="📋"
            android:contentDescription="Copy text" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
