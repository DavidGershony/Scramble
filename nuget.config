<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Accept packages with revoked author certificates (ReactiveUI / Splat).
       The maintainer's code-signing cert was revoked by the CA; the packages
       themselves are unchanged and published to nuget.org with repository
       countersignatures intact. Remove this once the packages are re-signed. -->
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
